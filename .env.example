# PulseRun client configuration.
#
# Copy to `.env` and fill in the values. `.env` is gitignored; this template is
# not. Flags passed on the command line always win over these variables.

# ---------------------------------------------------------------------------
# Shared (CLI + daemon)
# ---------------------------------------------------------------------------

# testnet | futurenet | mainnet | local
PULSERUN_NETWORK=testnet

# Soroban RPC endpoint. Leave unset to use the preset for PULSERUN_NETWORK.
# PULSERUN_RPC_URL=https://soroban-testnet.stellar.org

# PulseRun escrow contract ID (C...). Required by both packages.
PULSERUN_CONTRACT_ID=

# Stellar secret key (S...). Required by the CLI (`run`) and by the daemon.
# NEVER commit a real key.
PULSERUN_SECRET_KEY=

# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------

# Delay between event polls, in milliseconds.
PULSERUN_POLL_INTERVAL_MS=5000

# Ledgers behind the chain head to start watching from on first boot.
PULSERUN_START_LEDGER_OFFSET=100

# Maximum number of contract events requested per poll (1-200).
PULSERUN_EVENT_PAGE_LIMIT=100

# Docker endpoint: unix://..., npipe://... or tcp://host:port.
PULSERUN_DOCKER_HOST=unix:///var/run/docker.sock

# Sandbox resource limits.
PULSERUN_CPU_LIMIT=1
PULSERUN_MEMORY_LIMIT_MB=1024
PULSERUN_PIDS_LIMIT=256

# Give sandboxes network access (off by default; jobs are offline only).
PULSERUN_ALLOW_NETWORK=false

# Hard wall-clock limit for a single job, in seconds.
PULSERUN_JOB_TIMEOUT_SECONDS=900

# How many jobs the daemon executes at the same time.
PULSERUN_MAX_CONCURRENCY=1

# debug | info | warn | error
PULSERUN_LOG_LEVEL=info
