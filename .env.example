# PulseRun client configuration.
#
# Copy to `.env` and fill in the values. `.env` is gitignored; this template is
# not. Flags passed on the command line always win over these variables.
#
# Contract ids come from pulserun-core's deployment record:
# https://github.com/PulseRun-Labs/pulserun-core/blob/main/docs/deployments/testnet.md

# ---------------------------------------------------------------------------
# Shared (CLI + daemon)
# ---------------------------------------------------------------------------

# testnet | futurenet | mainnet | local
PULSERUN_NETWORK=testnet

# Soroban RPC endpoint. Leave unset to use the preset for PULSERUN_NETWORK.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase override. Leave unset to use the preset.
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# PulseEscrow contract ID (C...). Required by both packages.
PULSEESCROW_ID=

# Stellar secret key (S...). Required for any write (CLI `run` and the daemon).
# NEVER commit a real key.
PULSERUN_SECRET_KEY=

# Payment token used to denominate jobs (SEP-41 or a SAC). Required by `run`.
MOCKTOKEN_ID=

# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------

# JSON file mapping job id -> { image, command }. The contract does not store the
# command line yet, so the runner reads it out of band.
PULSERUN_JOB_SPECS_FILE=./pulserun-jobs.json

# Delay between chain polls, in milliseconds.
PULSERUN_POLL_INTERVAL_MS=5000

# Docker endpoint: unix://..., npipe://... or tcp://host:port.
PULSERUN_DOCKER_HOST=unix:///var/run/docker.sock

# Sandbox resource limits.
PULSERUN_CPU_LIMIT=1
PULSERUN_MEMORY_LIMIT_MB=1024
PULSERUN_PIDS_LIMIT=256

# Give sandboxes network access (off by default; jobs are offline only).
PULSERUN_ALLOW_NETWORK=false

# Hard wall-clock limit for a single job, in seconds.
PULSERUN_JOB_TIMEOUT_SECONDS=900

# How many jobs the daemon executes at the same time.
PULSERUN_MAX_CONCURRENCY=1

# Claim payouts automatically once the dispute window has elapsed.
PULSERUN_AUTO_CLAIM=true

# debug | info | warn | error
PULSERUN_LOG_LEVEL=info
